# ============================================================
#  Kids TV Backend — muhit o'zgaruvchilari (namuna)
#  Ishlatish:  cp .env.example .env   va qiymatlarni o'zgartiring
#  DIQQAT: .env faylini hech qachon git'ga qo'shmang!
# ============================================================

# ---------- Umumiy ----------
# development | production | test
NODE_ENV=development
PORT=3000
# Foydalanuvchi tz yubormasa ishlatiladigan IANA timezone
DEFAULT_TIMEZONE=Asia/Tashkent
# Nginx ortida ishlaganda proxy soni (to'g'ri IP aniqlash / rate limit uchun)
TRUST_PROXY=1
# Swagger hujjati (/docs). Productionda odatda false
SWAGGER_ENABLED=true

# ---------- PostgreSQL ----------
# docker-compose ichidagi postgres uchun ma'lumotlar
POSTGRES_USER=kidstv
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=kidstv
# Lokal ishga tushirishda (host -> docker postgres, port 5433)
DATABASE_URL=postgresql://kidstv:change_me_strong_password@localhost:5433/kidstv?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- JWT / Auth ----------
# Kamida 32 belgi! Generatsiya:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_long_random_secret_at_least_32_chars
# Access token muddati (soniya). 900 = 15 daqiqa
JWT_ACCESS_TTL_SEC=900
# Refresh token muddati (kun)
REFRESH_TOKEN_TTL_DAYS=30
# HTTPS bo'lsa true (productionda albatta true)
COOKIE_SECURE=false
# Ixtiyoriy: cookie domeni (masalan .kidstv.uz)
COOKIE_DOMAIN=

# ---------- CORS ----------
# Admin panel manzillari, vergul bilan. Bo'sh = developmentda hammasiga ruxsat
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ---------- Rate limit ----------
# Bitta IP uchun daqiqasiga so'rovlar soni
RATE_LIMIT_PER_MINUTE=120

# ---------- Media URL siyosati ----------
# http:// URL'larga ruxsat (tavsiya etilmaydi). Default: false
ALLOW_HTTP_MEDIA=false
# Faqat shu domenlardan video qabul qilish (vergul bilan). Bo'sh = istalgan ommaviy domen
ALLOWED_MEDIA_HOSTS=
# URL health-check timeout (ms)
URL_CHECK_TIMEOUT_MS=8000
# Har 6 soatda barcha URL'larni avtomatik tekshirish
URL_CHECK_CRON_ENABLED=true

# ---------- Seed (birinchi super admin) ----------
SEED_ADMIN_EMAIL=admin@kidstv.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
# Demo kanallar / multfilmlar / jadval yaratish
SEED_DEMO_DATA=true

# ---------- Deploy (Nginx + Let's Encrypt) ----------
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com
